#!/usr/bin/env bash
set -euo pipefail
cd /workspace/{{ workspace_name }}

# Explicit extension only; no inherited extensions or shell/write/edit tools.
# Do not remove --no-mcp or expand the tool list without reviewing permissions.
exec pi \
  --no-extensions \
  --extension "/workspace/{{ workspace_name }}/.pi/extensions/experiments.ts" \
  --no-mcp \
  --tools read,grep,find,ls,run_experiment,list_experiments,compare_experiments \
  "$@"
