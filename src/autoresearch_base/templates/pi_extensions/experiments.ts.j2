/**
 * Minimal experiment-only Pi extension.
 *
 * Accepts model-selected shell commands, records runs under /results,
 * and exposes result summaries. Commands may inspect CLI help before running.
 * Edit it from the normal development devcontainer, then /reload in Pi.
 *
 * Commands execute with the container user's permissions. Docker read-only
 * bind mounts, not command restrictions here, protect the project source.
 */

import { spawn } from "node:child_process";
import { randomUUID } from "node:crypto";
import { open, readFile, readdir, writeFile, mkdir } from "node:fs/promises";
import path from "node:path";
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { Type } from "@sinclair/typebox";

const RESULTS = "/results";
const RUNNER = "/workspace/{{ workspace_name }}/experiments/run.sh";
const MAX_RUN_MS = 15 * 60 * 1000;
const LOG_TAIL_BYTES = 4096;
const MAX_SCANNED_RUNS = 1000;

type RunRecord = {
  run_id: string;
  command: string;
  started_at: string;
  finished_at: string;
  duration_ms: number;
  exit_code: number;
  timed_out: boolean;
  aborted: boolean;
  spawn_error?: string;
};

async function loadJson(filePath: string): Promise<Record<string, unknown> | null> {
  try {
    const value: unknown = JSON.parse(await readFile(filePath, "utf8"));
    if (value !== null && typeof value === "object" && !Array.isArray(value)) {
      return value as Record<string, unknown>;
    }
  } catch {
    // A run may be incomplete, or its metrics may not be valid JSON.
  }
  return null;
}

async function tailFile(filePath: string, maxBytes = LOG_TAIL_BYTES): Promise<string> {
  const file = await open(filePath, "r");
  try {
    const info = await file.stat();
    const length = Math.min(info.size, maxBytes);
    const buffer = Buffer.alloc(length);
    await file.read(buffer, 0, length, info.size - length);
    return buffer.toString("utf8");
  } finally {
    await file.close();
  }
}

async function collectRuns(): Promise<Array<{record: Record<string, unknown>; metrics: Record<string, unknown> | null}>> {
  const entries = await readdir(RESULTS, { withFileTypes: true });
  const runs = [] as Array<{record: Record<string, unknown>; metrics: Record<string, unknown> | null}>;
  for (const entry of entries.filter((entry) => entry.isDirectory()).slice(0, MAX_SCANNED_RUNS)) {
    // Run IDs are generated by this extension, never accepted from the model.
    const directory = path.join(RESULTS, entry.name);
    const record = await loadJson(path.join(directory, "run.json"));
    if (record === null || record.run_id !== entry.name) continue;
    const metrics = await loadJson(path.join(directory, "metrics.json"));
    runs.push({ record, metrics });
  }
  runs.sort((a, b) => String(b.record.finished_at ?? "").localeCompare(String(a.record.finished_at ?? "")));
  return runs;
}

export default function (pi: ExtensionAPI) {
  pi.registerTool({
    name: "run_experiment",
    label: "Run experiment",
    description: "Execute a shell command in the experiment container, including --help discovery. Persist command, logs, and optional metrics under /results. Commands start in their run directory; use absolute /project paths and $RUN_DIR for outputs.",
    parameters: Type.Object({
      command: Type.String({ minLength: 1 }),
    }),
    async execute(_id, params, signal) {
      const runId = randomUUID();
      const runDir = path.join(RESULTS, runId);
      const startedAt = new Date().toISOString();
      const startTime = Date.now();
      await mkdir(runDir, { recursive: false });
      const logFile = await open(path.join(runDir, "run.log"), "wx", 0o600);
      let timedOut = false;
      let aborted = false;
      let spawnError: string | undefined;
      let exitCode = 1;

      try {
        const child = spawn("bash", [RUNNER, runDir, params.command], {
          cwd: runDir,
          detached: true,
          stdio: ["ignore", logFile.fd, logFile.fd],
          env: {
            // Deliberately do NOT pass credentials/model API keys to experiments.
            PATH: process.env.PATH ?? "/usr/local/bin:/usr/bin:/bin",
            HOME: "/home/node",
            LANG: "C.UTF-8",
            PYTHONPATH: "/project:/project/src",
            PYTHONDONTWRITEBYTECODE: "1",
          },
        });
        const kill = () => {
          if (child.pid !== undefined) {
            try { process.kill(-child.pid, "SIGKILL"); } catch { /* already exited */ }
          }
        };
        const onAbort = () => { aborted = true; kill(); };
        const timer = setTimeout(() => { timedOut = true; kill(); }, MAX_RUN_MS);
        signal?.addEventListener("abort", onAbort, { once: true });
        if (signal?.aborted) onAbort();
        try {
          exitCode = await new Promise<number>((resolve) => {
            child.once("error", (error) => { spawnError = String(error); resolve(1); });
            child.once("close", (code) => resolve(code ?? 1));
          });
        } finally {
          clearTimeout(timer);
          signal?.removeEventListener("abort", onAbort);
        }
      } finally {
        await logFile.close();
      }

      const record: RunRecord = {
        run_id: runId,
        command: params.command,
        started_at: startedAt,
        finished_at: new Date().toISOString(),
        duration_ms: Date.now() - startTime,
        exit_code: exitCode,
        timed_out: timedOut,
        aborted: aborted,
        ...(spawnError ? { spawn_error: spawnError } : {}),
      };
      await writeFile(path.join(runDir, "run.json"), JSON.stringify(record, null, 2) + "\n", { flag: "wx" });
      const metrics = await loadJson(path.join(runDir, "metrics.json"));
      const logTail = await tailFile(path.join(runDir, "run.log"));

      return {
        content: [{ type: "text", text: JSON.stringify({ ...record, run_dir: runDir, metrics, log_tail: logTail }) }],
        details: { ...record, run_dir: runDir, metrics },
        isError: exitCode !== 0 || timedOut || aborted,
      };
    },
  });

  pi.registerTool({
    name: "list_experiments",
    label: "List experiments",
    description: "Inspect recent experiment metadata and metrics without running shell commands.",
    parameters: Type.Object({
      limit: Type.Optional(Type.Integer({ minimum: 1, maximum: 50 })),
    }),
    async execute(_id, params) {
      const runs = (await collectRuns()).slice(0, params.limit ?? 20);
      return {
        content: [{ type: "text", text: JSON.stringify(runs) }],
        details: { count: runs.length },
      };
    },
  });

  pi.registerTool({
    name: "compare_experiments",
    label: "Compare experiments",
    description: "Rank valid completed experiments by one numeric metric; does not decide scientific significance.",
    parameters: Type.Object({
      metric: Type.String({ pattern: "^[A-Za-z][A-Za-z0-9_]*$", maxLength: 80 }),
      direction: Type.Union([Type.Literal("min"), Type.Literal("max")]),
    }),
    async execute(_id, params) {
      const ranked = (await collectRuns())
        .filter(({ record, metrics }) =>
          record.exit_code === 0 &&
          record.timed_out === false &&
          record.aborted === false &&
          metrics !== null &&
          typeof metrics[params.metric] === "number" &&
          Number.isFinite(metrics[params.metric])
        )
        .map(({ record, metrics }) => ({
          run_id: record.run_id,
          command: record.command,
          metric: params.metric,
          value: (metrics as Record<string, number>)[params.metric],
        }))
        .sort((a, b) => params.direction === "min" ? a.value - b.value : b.value - a.value)
        .slice(0, 20);
      return {
        content: [{ type: "text", text: JSON.stringify({ direction: params.direction, ranking: ranked }) }],
        details: { metric: params.metric, direction: params.direction, count: ranked.length },
      };
    },
  });
}
