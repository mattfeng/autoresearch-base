#!/usr/bin/env bash
# Command runner. Project write protection comes from Docker read-only mounts.
set -euo pipefail

if [[ "$#" -ne 2 ]]; then
  echo "Usage: run.sh <absolute-output-directory> <command>" >&2
  exit 2
fi

export RUN_DIR="$1"
COMMAND="$2"
PROJECT_DIR="${AUTORESEARCH_PROJECT_DIR:-/project}"

if [[ "$RUN_DIR" != /* || -z "$COMMAND" ]]; then
  echo "Expected an absolute output path and a nonempty command" >&2
  exit 2
fi

mkdir -p "$RUN_DIR" "$RUN_DIR/cache" "$RUN_DIR/tmp"
export TMPDIR="$RUN_DIR/tmp"
export XDG_CACHE_HOME="$RUN_DIR/cache"
export UV_CACHE_DIR="$RUN_DIR/cache/uv"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$PROJECT_DIR:$PROJECT_DIR/src"
export JAX_COMPILATION_CACHE_DIR="$RUN_DIR/cache/jax"

cd "$RUN_DIR"
exec bash -euo pipefail -c "$COMMAND"
