"""Zero-dependency smoke test: REPLACE with your actual experiment.

Always read code/data from --project, never write there. All experiment
artifacts and metrics go under --output. Fail with a nonzero exit status on
invalid results; keep metric names and evaluation protocol stable.
"""

from __future__ import annotations

import argparse
import json
import time
from pathlib import Path


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--project", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--seed", type=int, required=True)
    args = parser.parse_args()

    start = time.monotonic()
    if not args.project.is_dir():
        parser.error(f"project folder does not exist: {args.project}")
    args.output.mkdir(parents=True, exist_ok=True)

    # Use /project/src if it exists; this is a smoke-test objective, not a
    # scientific or optimization metric.
    source_dir = args.project / "src"
    source_count = sum(1 for _ in source_dir.rglob("*.py")) if source_dir.is_dir() else 0
    metrics = {
        "python_source_count": source_count,
        "seed": args.seed,
        "duration_seconds": time.monotonic() - start,
    }
    (args.output / "metrics.json").write_text(
        json.dumps(metrics, indent=2) + "\n", encoding="utf-8"
    )
    print(json.dumps(metrics))


if __name__ == "__main__":
    main()
