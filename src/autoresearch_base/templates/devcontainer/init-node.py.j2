"""Seed node's persistent Pi settings, then replace this process with the command."""

from copy import deepcopy
import json
import os
from pathlib import Path
import pwd
import sys
import tempfile


DEFAULTS_PATH = Path("/usr/local/lib/autoresearch/pi-settings.json")


def read_settings(path: Path) -> dict:
    """Reject malformed settings instead of replacing user configuration."""
    try:
        settings = json.loads(path.read_text(encoding="utf-8"))
    except (ValueError, UnicodeError) as error:
        raise ValueError(f"Invalid Pi settings in {path}: {error}") from error
    if not isinstance(settings, dict):
        raise ValueError(f"Invalid Pi settings in {path}: expected a JSON object")
    return settings


def _fill_missing(settings: dict, defaults: dict) -> None:
    for key, value in defaults.items():
        if key not in settings:
            settings[key] = value
        elif isinstance(value, dict) and isinstance(settings[key], dict):
            _fill_missing(settings[key], value)


def _write_agent_config(home: Path, filename: str, config: dict) -> None:
    pi_dir = home / ".pi"
    settings_dir = pi_dir / "agent"
    pi_dir.mkdir(mode=0o700, exist_ok=True)
    settings_dir.mkdir(mode=0o700, exist_ok=True)
    descriptor, temporary_path = tempfile.mkstemp(prefix=f".{filename}-", suffix=".json", dir=settings_dir)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            os.fchmod(stream.fileno(), 0o600)
            json.dump(config, stream, indent=2)
            stream.write("\n")
        os.replace(temporary_path, settings_dir / filename)
    finally:
        Path(temporary_path).unlink(missing_ok=True)


def seed_keybindings(home: Path) -> bool:
    path = home / ".pi/agent/keybindings.json"
    try:
        bindings = read_settings(path)
    except FileNotFoundError:
        bindings = {}
    if "app.session.rename" in bindings:
        return False
    bindings["app.session.rename"] = "alt+r"
    _write_agent_config(home, "keybindings.json", bindings)
    return True


def seed_settings(home: Path, defaults_path: Path) -> bool:
    """Fill missing defaults without changing existing provider/model choices."""
    defaults = read_settings(defaults_path)
    pi_dir = home / ".pi"
    settings_dir = pi_dir / "agent"
    settings_path = settings_dir / "settings.json"
    try:
        settings = read_settings(settings_path)
    except FileNotFoundError:
        settings = {}

    original = deepcopy(settings)
    if "defaultProvider" not in settings and "defaultModel" not in settings:
        for key in ("defaultProvider", "defaultModel"):
            if key in defaults:
                settings[key] = defaults[key]
    _fill_missing(
        settings,
        {key: value for key, value in defaults.items()
         if key not in ("defaultProvider", "defaultModel", "packages")},
    )
    packages = settings.setdefault("packages", [])
    if not isinstance(packages, list):
        raise ValueError(f"Invalid Pi packages in {settings_path}: expected a list")
    for package in defaults.get("packages", []):
        if not any(
            (entry.get("source") if isinstance(entry, dict) else entry) == package
            for entry in packages
        ):
            packages.append(package)
    if settings == original:
        return False

    _write_agent_config(home, "settings.json", settings)
    return True


def main() -> None:
    if os.geteuid() != pwd.getpwnam("node").pw_uid:
        raise SystemExit("init-node: must run as node")
    if len(sys.argv) < 2:
        raise SystemExit("init-node: a command is required")
    try:
        seed_settings(Path.home(), DEFAULTS_PATH)
        seed_keybindings(Path.home())
    except (OSError, ValueError) as error:
        raise SystemExit(f"init-node: {error}") from error
    os.execvp(sys.argv[1], sys.argv[1:])


if __name__ == "__main__":
    main()
