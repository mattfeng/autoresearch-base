{
  "name": {{ ("Pi autoresearch: " ~ workspace_name) | tojson }},
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "overrideCommand": false,
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/bin/zsh",
            "args": ["-l"]
          }
        }
      }
    }
  },
  "workspaceFolder": {{ ("/workspace/" ~ workspace_name) | tojson }},
  "workspaceMount": {{ ("source=${localWorkspaceFolder},target=/workspace/" ~ workspace_name ~ ",type=bind") | tojson }},
  "mounts": [
{% for mount in read_only_mounts %}
    {{ ("source=${localWorkspaceFolder}/" ~ mount.relative_source ~ ",target=" ~ mount.target ~ ",type=bind,readonly") | tojson }},
{% endfor %}
    {{ ("source=" ~ volume_name ~ ",target=/home/node/.pi,type=volume") | tojson }}
  ],
  "containerEnv": {
    "PYTHONPATH": "/project:/project/src",
    "PYTHONDONTWRITEBYTECODE": "1",
    "TRACKIO_DIR": {{ ("/workspace/" ~ workspace_name ~ "/trackio") | tojson }},
    "TRACKIO_STORAGE_MODE": "jsonl",
    "TRACKIO_SQLITE_MMAP_SIZE": "0",
    "XDG_CACHE_HOME": {{ ("/workspace/" ~ workspace_name ~ "/results/.cache") | tojson }},
    "UV_CACHE_DIR": {{ ("/workspace/" ~ workspace_name ~ "/results/.cache/uv") | tojson }},
    "JAX_COMPILATION_CACHE_DIR": {{ ("/workspace/" ~ workspace_name ~ "/results/.cache/jax") | tojson }},
    "UV_PROJECT_ENVIRONMENT": {{ ("/tmp/" ~ workspace_name ~ "/.venv") | tojson }}
  },
  "runArgs": [
{% if gpus %}
    "--gpus=all",
{% endif %}
    "--shm-size=1g",
    "--cap-drop=ALL",
    "--cap-add=NET_ADMIN",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--cap-add=SETPCAP",
    "--security-opt=no-new-privileges",
    "--pids-limit=512"
  ]
}
